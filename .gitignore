# Rust
/target/
**/*.rs.bk

# Node (web frontend and docs site)
node_modules/
dist/
.astro/

# Environment
.env
.env.*
!.env.example

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Local data dumps (imported via pipelines, never committed)
/data/

# Generated by `lyrid layout`: a tile pyramid is an artefact of a layout run,
# reproducible from the canon, and 6 MB of binary that would churn on every
# re-layout.
/tiles/
/web/public/tiles/

# A benchmark run's output; the baseline that matters is committed beside it.
/web/prototype/benchmark.json

# Staging directory assembled by tools/stage-deploy.sh for a stand upload.
/deploy/

# Local working artifacts: slice dumps and anything else not meant to ship.
/.local/
