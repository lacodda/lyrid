{
  "name": "lyrid-web",
  "version": "0.8.0",
  "description": "A music universe: a canonical sky of artists and genres you explore through real listening.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
